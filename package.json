{
    "name": "power-math",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.0.0",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "deploy": "bash scripts/deploy.sh",
        "format": "prettier --write \"src/**/*.{ts,vue,scss}\""
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.5.1",
        "@fortawesome/free-solid-svg-icons": "^6.5.1",
        "@fortawesome/vue-fontawesome": "^3.0.6",
        "@oruga-ui/oruga-next": "^0.8.7",
        "@oruga-ui/theme-bulma": "^0.3.0",
        "animate.css": "^4.1.1",
        "bulma": "^0.9.4",
        "katex": "^0.16.10",
        "vue": "^3.4.21"
    },
    "devDependencies": {
        "@types/katex": "^0.16.7",
        "@types/node": "^20.12.7",
        "@vitejs/plugin-vue": "^5.0.4",
        "prettier": "^3.2.5",
        "sass": "^1.75.0",
        "typescript": "^5.4.5",
        "vite": "^5.2.0",
        "vitest": "^1.5.0",
        "vue-tsc": "^2.0.14"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
